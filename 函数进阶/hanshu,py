#不定长参数-位置传递(*args)
#   注意传递的所有匹配的位置参数都会被args变量收集
#   并会封装为一个元组,args为元组类型(不会封装关键词参数)

def cal_data(*args):
    min_data = min(args)
    max_data = max(args)
    avg_data = sum(args) / len(args)
    return min_data,max_data,round(avg_data,1)#round(avg_data,1):
                                              #avg_data保留一位小数

data = cal_data(10,20,30,40,50,60,70)
print(data)


#不定长参数-关键字传递(*kwargs)
#   注意传递的所有匹配的位置参数都会被kwargs变量收集
#   并会封装为一个字典,kwargs为字典类型(不会封装位置传递参数)
def cal_data(*args,**kwargs):
    min_data = min(args)
    max_data = max(args)
    avg_data = sum(args) / len(args)

    if kwargs.get("round") is not None:
        avg_data = round(avg_data,kwargs.get("round"))
# get 是 Python 字典（dict）的内置方法，作用是：根据指定的键（key） 
# 从字典中获取对应的值（value），如果这个键不存在，不会报错，
# 而是返回一个默认值（默认是 None）。
    
    if kwargs.get("print"):
        print(f"计算出的最大值:{max_data},最小值:{min_data},平均值:{avg_data}")
    
    return max_data,min_data,avg_data
data = cal_data(10,20,30,40,50,60,70,round = 3,print=True)
print(data)
